# Company Brain — environment configuration.
# Everything here is OPTIONAL. With none of it set, Company Brain runs as a
# single-user, one-container, fully-local install (PGlite, BM25 recall, no host
# execution). The variables below are opt-in upgrades.

# --- Workspace / database ---------------------------------------------------
# COMPANY_BRAIN_WORKSPACE_DIR=./data/workspace
# Optional Postgres (else PGlite). Enables the pgvector ANN upgrade when the
# `vector` extension is available (else recall uses portable JSON + JS cosine).
# COMPANY_BRAIN_DATABASE_URL=postgres://user:pass@host:5432/company_brain

# --- Auth / RBAC (Phase 5) — off by default ---------------------------------
# When unset, the server runs unauthenticated as a single local-user admin.
# COMPANY_BRAIN_ENABLE_AUTH=1
# COMPANY_BRAIN_SESSION_SECRET=change-me-to-a-long-random-string
# Users + tokens live server-side (NEVER in the workspace git). JSON array of
# {id?,name,email?,role,token}; role ∈ viewer|editor|admin.
# COMPANY_BRAIN_USERS=[{"name":"Ada","email":"ada@x.io","role":"admin","token":"..."}]
# CLI/MCP authenticate with a bearer token:
# COMPANY_BRAIN_API_TOKEN=...
# Cross-origin allowlist (comma-separated); same-origin web + CLI/MCP unaffected:
# COMPANY_BRAIN_ALLOWED_ORIGINS=https://brain.example.com

# --- Host execution (agents) — off by default -------------------------------
# COMPANY_BRAIN_ENABLE_SCHEDULER=1          # run scheduled jobs (spawns agent CLIs)
# COMPANY_BRAIN_ENABLE_AGENT_RUN_API=1      # allow HTTP-triggered agent runs
# COMPANY_BRAIN_AGENT_RUN_TOKEN=...         # legacy run-token (auth-off mode only)

# --- Memory extraction (Phase 6) — off by default ---------------------------
# LLM-driven extraction of memories from finished conversations. HOST EXECUTION,
# admin-only, requires a configured agent provider. Never auto-runs unless set.
# COMPANY_BRAIN_ENABLE_MEMORY_EXTRACTION=1

# --- Hybrid retrieval embeddings (Phase 6) — off by default -----------------
# Configuring an embedding provider enables the `hybrid_rrf_v1` recall mode
# (BM25 fused with vector similarity via Reciprocal Rank Fusion). Unset → recall
# stays BM25-only and `hybrid_rrf_v1` degrades to BM25.
#
# ⚠️ DATA-SHARING TRUST BOUNDARY: enabling this transmits indexed chunk text —
# page content, memory facts, source-artifact excerpts (possibly PII/confidential)
# — to the third-party embedding endpoint you configure. The baseline install
# sends data to no one. Only enable against an endpoint you trust.
#
# ⚠️ BASELINE SCALE LIMIT: on PGlite the vector search is a brute-force cosine
# scan over all embeddings (bounded + logged). For large workspaces, use
# Postgres + pgvector (set COMPANY_BRAIN_DATABASE_URL) for ANN-backed recall.
# COMPANY_BRAIN_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
# COMPANY_BRAIN_EMBEDDING_API_KEY=...
# COMPANY_BRAIN_EMBEDDING_MODEL=text-embedding-3-small
# COMPANY_BRAIN_EMBEDDING_DIM=1536
# COMPANY_BRAIN_EMBEDDING_BATCH=64
